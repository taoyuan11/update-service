# Required for first-run administrator bootstrap
DATABASE_URL=postgres://update_service:change-me@postgres:5432/update_service
INITIAL_ADMIN_USERNAME=admin
# Must be at least 12 characters on the first startup
INITIAL_ADMIN_PASSWORD=change-this-before-production
# Base64-encoded 32-byte value. Generate with: openssl rand -base64 32
SETTINGS_MASTER_KEY=REPLACE_WITH_A_32_BYTE_BASE64_KEY
APP_BASE_URL=http://localhost:8080
APP_BIND=0.0.0.0:8080
UPLOAD_MAX_BYTES=2147483648
# Uploads and storage migrations use this directory for temporary files.
# It must have enough free space for the largest artifact being transferred.
UPLOAD_TEMP_DIR=/tmp/update-service
COOKIE_SECURE=false
